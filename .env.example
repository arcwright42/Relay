# Copy this file to .env in the directory where you run cargo run.
# Jev project routing uses the OpenRouter Decisions API with typesafe/jev-1.13.
# Alternatively, export OPENROUTER_API_KEY in the launching process.
# Precedence: process environment > .env > API key saved in macOS Keychain.
OPENROUTER_API_KEY=

# Voice ASR/TTS, independent of Jev. Prefer the signed app's --voice-save-key
# command (stdin only) to store this in macOS Keychain instead of a file.
DASHSCOPE_API_KEY=
# Empty uses Qianwen's unified endpoint. For Alibaba regional keys only:
# cn-beijing or ap-southeast-1, optionally with a dedicated workspace ID.
RELAY_VOICE_REGION=
DASHSCOPE_WORKSPACE_ID=
